# Copy to .env — navi loads it from the current directory at startup.
# An explicit environment variable always wins over this file.
#
# One provider key is enough. The default model is deepseek/deepseek-v4-flash.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
#
# Optional: pick a different model (provider/model), e.g.
# NAVI_MODEL=deepseek/deepseek-v4-pro
#
# Optional: the web-search flow needs this. Without it that flow reports
# Blocked rather than inventing sources.
# TAVILY_API_KEY=
